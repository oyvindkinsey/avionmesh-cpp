{
    "name": "avionmesh",
    "version": "1.1.1",
    "description": "Avi-on Bluetooth mesh light command library (C++20)",
    "keywords": "ble,mesh,avion,csrmesh,light",
    "frameworks": "espidf",
    "platforms": "espressif32",
    "build": {
        "flags": [
            "-std=gnu++20",
            "-Iinclude",
            "-Iexternal/recsrmesh/include",
            "-Iexternal/recsrmesh/external/micro-ecc"
        ],
        "srcDir": ".",
        "srcFilter": "+<src/> +<external/recsrmesh/src/>"
    }
}
